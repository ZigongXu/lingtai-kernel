+def test_delayed_grant_time_and_genuinely_stale_request_remain_rejected(
+    tmp_path,
+    monkeypatch,
+):
+    grant_time = "2026-08-12T00:00:00Z"
+    submit_time = "2026-08-12T00:10:01Z"
